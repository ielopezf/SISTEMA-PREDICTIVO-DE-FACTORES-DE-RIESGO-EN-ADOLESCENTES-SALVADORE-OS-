# --- Datos (no versionar archivos pesados; sí las plantillas .gitkeep) ---
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# --- Modelos serializados ---
models/*
!models/.gitkeep

# --- Figuras generadas ---
reports/figures/*
!reports/figures/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# --- Entorno / editores ---
.vscode/
.idea/
.DS_Store
.env
